# Generated by fqe init. This workflow has no write permissions or signing key.
name: FQE Quality
on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
  pull_request_review:
    types: [submitted, dismissed]
permissions:
  contents: read
  pull-requests: read
jobs:
  evaluate:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@v5
        with:
          node-version: '22'
      - name: Install fqe CLI (ref-pinned)
        run: |
          set -euo pipefail
          FQE_REF="fqe-v0.19.1"
          FQE_SRC="$(mktemp -d "${RUNNER_TEMP:-/tmp}/fqe-src.XXXXXX")"
          git -C "$FQE_SRC" init -q .
          git -C "$FQE_SRC" fetch -q --depth=1 https://github.com/booyajones/fqe.git "$FQE_REF"
          git -C "$FQE_SRC" checkout -q --detach FETCH_HEAD
          cd "$FQE_SRC/cli"
          npm ci --omit=dev
          chmod +x bin/fqe.js
          sudo ln -sf "$PWD/bin/fqe.js" /usr/local/bin/fqe
          fqe version
      - name: Run fqe in a fresh output directory
        env:
          HEAD_SHA: ${{ github.event.pull_request.head.sha }}
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          set -euo pipefail
          FQE_OUT="$(mktemp -d "${RUNNER_TEMP:-/tmp}/fqe-results.XXXXXX")"
          echo "FQE_OUT=$FQE_OUT" >> "$GITHUB_ENV"
          # Context is checked against server run metadata again by the publisher.
          printf '{"pr":%s,"head":"%s"}\n' "$PR_NUMBER" "$HEAD_SHA" > "$FQE_OUT/context.json"
          set +e
          fqe run --commit "$HEAD_SHA" --base "$BASE_SHA" --pr "$PR_NUMBER" \
            --run-id "$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT" --output "$FQE_OUT"
          rc=$?
          set -e
          case "$rc" in 0|3) exit 0 ;; *) exit "$rc" ;; esac
      - name: Upload test evidence
        if: always() && env.FQE_OUT != ''
        uses: actions/upload-artifact@v4
        with:
          name: qa-receipt-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ env.FQE_OUT }}/
          if-no-files-found: error
          retention-days: 90
